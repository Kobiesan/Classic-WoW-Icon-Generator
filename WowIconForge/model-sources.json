    },
    {
      "relativePath": "tokenizer/vocab.json",
      "url": "https://huggingface.co/<owner>/<repo>/resolve/main/tokenizer/vocab.json",
      "sha256": "",
      "sizeBytes": 0
    },
    {
      "relativePath": "tokenizer/merges.txt",
      "url": "https://huggingface.co/<owner>/<repo>/resolve/main/tokenizer/merges.txt",
      "sha256": "",
      "sizeBytes": 0
    }
  ]
